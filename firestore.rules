rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPilot() {
      return signedIn() && request.auth.token.role in ['pilot', 'admin'];
    }

    // 이륙/착륙 이벤트: 조회는 로그인 사용자, 생성은 pilot/admin만
    match /flight_events/{eventId} {
      allow read: if signedIn();
      allow create: if isPilot();
      allow update: if false;
      allow delete: if signedIn();
    }

    // 푸시 알림 토큰
    match /fcm_tokens/{tokenId} {
      allow read, write: if signedIn();
    }

    // 항적 (위치와 경로)
    match /tracking/{document=**} {
      allow read, write, delete: if signedIn();
    }

    // GPS 세션 잠금
    match /heli_status/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
